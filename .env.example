# 이 파일을 복사해 .env 로 만들고 값을 채우세요.  cp .env.example .env
# .env 는 .gitignore 에 있어 커밋되지 않습니다.
# 이 파일(.env.example)에는 절대 실제 키 값을 적지 않습니다 — 이름만 둡니다.
# 셸 환경변수가 .env 보다 우선합니다.

# 데이터 원본 루트 (기본값 D:\z03.SmartGrid)
#DATA_ROOT=

# VWorld 오픈API — https://www.vworld.kr (키가 도메인/referer 바인딩됨)
VWORLD_API_KEY=

# 통계청 SGIS — https://sgis.kostat.go.kr 개발지원센터
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# KOSIS 공유서비스 — https://kosis.kr/openapi
KOSIS_API_KEY=

# 공공데이터포털 — https://www.data.go.kr
DATA_GO_KR_KEY=

# Copernicus Data Space (Sentinel-2) — https://dataspace.copernicus.eu
CDSE_TOKEN=
